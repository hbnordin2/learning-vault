# Copy to ~/.config/learning-vault/.env (on Windows: %USERPROFILE%\.config\learning-vault\.env)
# and fill in. The file lives OUTSIDE the vault, so no key ever lands in git.
# learncast and the media feed both read it.

# --- Voices for podcasts (pick ONE provider) ----------------------------------
LEARNCAST_TTS_PROVIDER=elevenlabs      # elevenlabs | openai | gemini

# ElevenLabs: the best voices. The Creator plan (~100k credits a month) covers
# about four hour-long episodes; Starter (~30k) covers about one.
ELEVENLABS_API_KEY=

# OpenAI text-to-speech: cheaper, good. Needs an API key from
# platform.openai.com; a ChatGPT subscription does not include API credit.
OPENAI_API_KEY=

# Gemini: has a free tier.
GEMINI_API_KEY=

# --- Media feed (optional; see .tools/media-feed/README.md) -------------------
# MEDIA_BUCKET=
# MEDIA_PREFIX=
# MEDIA_PUBLIC_URL=
# MEDIA_REGION=
# MEDIA_S3_ENDPOINT=                   # only for Cloudflare R2 or another S3-compatible store
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_FEED_TITLE=Vault

# --- LLM (optional; only for `learncast generate`) ----------------------------
# The agent writes podcast scripts itself, so this is only for batch runs
# without an agent. Any OpenAI-compatible endpoint works.
# LEARNCAST_LLM_BASE_URL=https://api.openai.com/v1
# LEARNCAST_LLM_MODEL=<model id from your provider>
# LEARNCAST_LLM_API_KEY=

